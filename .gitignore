# ---------------------------------------------------------------------------
# Template-specific (keep in sync with README "ディレクトリ構成")
# ---------------------------------------------------------------------------
# Competition data is never committed; keep the directory skeleton.
data/**
!data/**/
!data/**/.gitkeep

# Keep run metadata and metrics (JSON/TOML/MD), not logs or runtime artifacts.
runs/**/stdout.log
runs/**/stderr.log
runs/**/*.log
runs/**/artifacts/

# Local caches and generated submissions.
cache/
.cache/
tmp/
submissions/*
!submissions/.gitkeep
